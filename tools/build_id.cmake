# Computes the build id: the first 12 hex digits of a SHA-256 over a manifest
# of the build settings and of every source file. Settings come in as
# variables: BUILD_TYPE, CXX_COMPILER (id and version), CXX_FLAGS (effective
# flags), CUDA (ON or OFF), CUDA_COMPILER, CUDA_FLAGS. The manifest holds one
# name=value line per setting, then one line per file with its relative path
# and the SHA-256 of its content with CR characters removed.
#
# The build runs it on every build with OUTPUT (a header defining HVS_BUILD_ID,
# HVS_BUILD_TYPE and HVS_CXX_FLAGS) and MANIFEST set; each file is rewritten
# only when its content changes, so unchanged sources do not relink. Without
# OUTPUT it prints the id, and with MANIFEST it writes the manifest there:
#   cmake -DSOURCE_DIR=<checkout> [-DOUTPUT=<header>] [-DMANIFEST=<file>]
#         -DBUILD_TYPE=... -DCXX_COMPILER=... ... -P tools/build_id.cmake
cmake_minimum_required(VERSION 3.22)

get_filename_component(SOURCE_DIR "${SOURCE_DIR}" ABSOLUTE)
file(GLOB_RECURSE files RELATIVE ${SOURCE_DIR}
     ${SOURCE_DIR}/include/* ${SOURCE_DIR}/src/* ${SOURCE_DIR}/benchmarks/*
     ${SOURCE_DIR}/tests/* ${SOURCE_DIR}/tools/*)
list(APPEND files CMakeLists.txt CMakePresets.json)
# Caches and editor backups are not sources.
list(FILTER files EXCLUDE REGEX
     "(^|/)(__pycache__|\\.pytest_cache)/|\\.pyc$|\\.swp$|~$")
# tools/plot.py only post-processes saved CSVs, so editing it must not change
# the id of the measured program.
list(REMOVE_ITEM files tools/plot.py)
list(SORT files)

set(manifest "")
foreach(name BUILD_TYPE CXX_COMPILER CXX_FLAGS CUDA CUDA_COMPILER CUDA_FLAGS)
  string(TOLOWER ${name} key)
  string(APPEND manifest "${key}=${${name}}\n")
endforeach()
foreach(path IN LISTS files)
  file(READ ${SOURCE_DIR}/${path} content)
  string(REPLACE "\r" "" content "${content}")
  string(SHA256 content_hash "${content}")
  string(APPEND manifest "${path} ${content_hash}\n")
endforeach()
string(SHA256 id "${manifest}")
string(SUBSTRING ${id} 0 12 id)

# Writes text to path unless path already holds it.
function(write_if_changed path text)
  set(old "")
  if(EXISTS ${path})
    file(READ ${path} old)
  endif()
  if(NOT old STREQUAL text)
    file(WRITE ${path} "${text}")
  endif()
endfunction()

if(MANIFEST)
  write_if_changed(${MANIFEST} "${manifest}")
endif()
if(NOT OUTPUT)
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo ${id})
  return()
endif()

# The flags as a C string literal.
string(REPLACE "\\" "\\\\" flags "${CXX_FLAGS}")
string(REPLACE "\"" "\\\"" flags "${flags}")
set(header "#pragma once\n// Generated by tools/build_id.cmake.\n")
string(APPEND header "#define HVS_BUILD_ID \"${id}\"\n")
string(APPEND header "#define HVS_BUILD_TYPE \"${BUILD_TYPE}\"\n")
string(APPEND header "#define HVS_CXX_FLAGS \"${flags}\"\n")
write_if_changed(${OUTPUT} "${header}")
